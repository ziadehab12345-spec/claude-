# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local:   postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo
# Managed: postgresql://user:pass@host/db?sslmode=require
#          (sslmode=require is mandatory for anything not on localhost)
DATABASE_URL=postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo

# Separate database used by `npm test`. It is TRUNCATEd between tests.
TEST_DATABASE_URL=postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs staff session cookies. At least 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical URLs, hreflang, the
# sitemap and link previews.
#   Production: https://cairopeople.com
#   Local:      http://localhost:3000
# Read at runtime, so changing it needs a restart, not a rebuild.
# Leave unset on Vercel preview deployments — they fall back to their own URL
# and are automatically excluded from search engines.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed (first run only)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cairopeople.com
SEED_ADMIN_PASSWORD=
