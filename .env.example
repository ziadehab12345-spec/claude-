# Postgres connection string.
# Local dev:      postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo
# Neon/Supabase:  postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo

# Separate database used by `npm test`. It is TRUNCATEd between tests.
TEST_DATABASE_URL=postgresql://ahl:ahl@127.0.0.1:5432/ahlcairo_test

# Secret used to sign staff/admin session cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site URL (used for absolute links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script: initial admin account. Change the password after first login.
SEED_ADMIN_EMAIL=admin@ahlcairo.com
SEED_ADMIN_PASSWORD=
